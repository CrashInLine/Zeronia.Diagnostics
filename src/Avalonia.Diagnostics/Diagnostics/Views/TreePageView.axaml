<UserControl x:Class="Avalonia.Diagnostics.Views.TreePageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="clr-namespace:Avalonia.Diagnostics.ViewModels;assembly=Avalonia.Diagnostics"
             x:DataType="vm:TreePageViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="0.35*,4,0.65*">
        <TreeView Name="tree"
                  BorderThickness="0"
                  ItemsSource="{Binding Nodes}"
                  PointerExited="RemoveAdorner"
                  PointerMoved="UpdateAdorner"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
            <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:TreeNode" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="{Binding FontWeight}" Text="{Binding Type}" />
                        <u:IconButton Command="{Binding NavigateToXamlSource}"
                                      Icon="{icon:MaterialIconExt Code}"
                                      Classes="Small"
                                      Theme="{StaticResource BorderlessIconButton}"
                                      IsVisible="{Binding SourceInfo, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding Classes}" />
                        <TextBlock Foreground="Gray" Text="{Binding ElementName}" />
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.DataTemplates>
            <TreeView.Styles>
                <Style x:DataType="vm:TreeNode" Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </TreeView.Styles>
            <TreeView.ContextFlyout>
                <MenuFlyout>
                    <MenuItem Header="Copy">
                        <MenuItem Command="{Binding CopySelector}" Header="Copy individual node selector" />
                        <MenuItem Command="{Binding CopySelectorFromTemplateParent}" Header="Copy selector from template parent" />
                    </MenuItem>
                    <MenuItem Header="-" />
                    <MenuItem Command="{Binding ExpandRecursively}" Header="Expand recursively" />
                    <MenuItem Command="{Binding CollapseChildren}" Header="Collapse children" />
                    <MenuItem Command="{Binding CaptureNodeScreenshot}" Header="Capture node screenshot" />
                    <MenuItem Command="{Binding BringIntoView}" Header="Bring into view" />
                    <MenuItem Command="{Binding Focus}" Header="Focus" />
                </MenuFlyout>
            </TreeView.ContextFlyout>
        </TreeView>

        <GridSplitter Grid.Column="1"
                      Width="1"
                      Background="{DynamicResource ThemeControlMidBrush}" />
        <ContentControl Grid.Column="2" Content="{Binding Details}" />
    </Grid>
</UserControl>
